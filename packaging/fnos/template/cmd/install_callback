#!/bin/bash
# 安装后：保存配置、建好数据目录并收紧权限。
# 重装时保留旧配置里向导没有收集的值（cron 密码），向导里填的值覆盖旧值。
. "$(dirname "$0")/functions"

port="${wizard_port:-}"
username="${wizard_username:-}"
password="${wizard_password:-}"

old_cron=""
if [ -f "${SETTINGS_FILE}" ]; then
  old_cron="$( unset MOONTV_CRON_PASSWORD; . "${SETTINGS_FILE}" 2>/dev/null; echo "${MOONTV_CRON_PASSWORD:-}" )"
fi

if ! valid_port "${port}"; then
  user_error "端口无效：${port}，请输入 1024-65535 之间的端口。"
  exit 1
fi
if [ -z "${username}" ] || [ -z "${password}" ]; then
  user_error "站长用户名和密码不能为空。"
  exit 1
fi

save_settings "${port}" "${username}" "${password}" "${old_cron:-$(random_hex)}" \
  || { user_error "无法写入配置文件 ${SETTINGS_FILE}"; exit 1; }
prepare_dirs || exit 1
remove_legacy_server
check_server || exit 1
log "installed ${TRIM_APPVER:-} port=${port}"
exit 0
