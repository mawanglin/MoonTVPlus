#!/bin/bash
# 卸载后：应用本体在 TRIM_APPDEST 里，由飞牛删除；这里只处理 TRIM_PKGVAR / TRIM_PKGETC。
# 数据库与配置默认保留，向导里关闭「保留」才删除。
# 只删本应用自己的目录（路径里必须带 moontvplus），防止变量异常时误删。
. "$(dirname "$0")/functions"

safe_rm() {
  case "$1" in
    */moontvplus/*|*/moontvplus) rm -rf --one-file-system "$1" ;;
    *) log "refuse to remove unexpected path: $1" ;;
  esac
}

remove_legacy_server
if [ "${wizard_keep_data:-true}" != "true" ]; then
  safe_rm "${DATA_DIR}"
  safe_rm "${HOME_DIR}"
  rm -f "${SETTINGS_FILE}" "${VAR_DIR}/.reinstall"
else
  # 告诉下一次 install_callback：这是卸载后重装，要用向导里新填的账号（见 install_callback）
  mkdir -p "${VAR_DIR}" && touch "${VAR_DIR}/.reinstall"
fi
exit 0
