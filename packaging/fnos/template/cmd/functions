#!/bin/bash
# MoonTVPlus 飞牛包的共用函数，由其他 cmd 脚本 source。
# 只依赖飞牛注入的 TRIM_* 变量。
#
# 目录约定：
#   TRIM_APPDEST  runtime/node   内置 Node.js 及其 libstdc++ / libgcc_s
#                 server/        应用本体（Next standalone + 生产依赖），直接在这里运行。
#                                飞牛把 TRIM_APPDEST 的属主设为包用户（run-as package），运行时
#                                写 public/manifest.json 与 .next/cache 没有问题（2026-11-12 真机确认）
#   TRIM_PKGETC   settings.env   端口、站长账号、cron 密码（600）
#   TRIM_PKGVAR   data/          SQLite 数据库
#                 logs/          日志与 pid
#                 home/          进程的 HOME
#
# 飞牛的 ZFS（trimacl 挂载）新建文件不受 umask 约束（真机上 umask 0027 仍建出 666 的文件），
# 所以每次安装、升级、启动时显式收紧权限：目录 750、文件 640。

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 027

APP_DIR="${TRIM_APPDEST:-/var/apps/${TRIM_APPNAME:-moontvplus}/target}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/${TRIM_APPNAME:-moontvplus}/var}"
ETC_DIR="${TRIM_PKGETC:-${VAR_DIR}/etc}"
SETTINGS_FILE="${ETC_DIR}/settings.env"
NODE="${APP_DIR}/runtime/node/bin/node"
SERVER_DIR="${APP_DIR}/server"
DATA_DIR="${VAR_DIR}/data"
LOG_DIR="${VAR_DIR}/logs"
LOG_FILE="${LOG_DIR}/moontvplus.log"
# pidfile 放在包用户自己的目录里（见 fnos-fpk 五类失败静默 #4）
PID_FILE="${LOG_DIR}/moontvplus.pid"
HOME_DIR="${VAR_DIR}/home"

log() {
  mkdir -p "${LOG_DIR}" 2>/dev/null
  echo "$(date '+%F %T') [fnos] $*" >> "${LOG_FILE}" 2>/dev/null
}

# 失败原因写进 TRIM_TEMP_LOGFILE，应用中心才能显示出来（否则只显示「原因未知」）。
# 注意 config_* 与 uninstall_* 阶段没有这个文件，只能看日志。
user_error() {
  log "ERROR: $*"
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "$*" >> "${TRIM_TEMP_LOGFILE}"
  echo "$*" >&2
}

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]
}

port_open() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# 建好数据目录并收紧权限（幂等）。数据库里有用户与播放记录，日志里有请求地址，只给包用户。
prepare_dirs() {
  local d
  mkdir -p "${DATA_DIR}" "${LOG_DIR}" "${HOME_DIR}" || { user_error "无法创建数据目录 ${VAR_DIR}"; return 1; }
  for d in "${DATA_DIR}" "${LOG_DIR}" "${HOME_DIR}"; do
    find "$d" -type d -exec chmod 750 {} + 2>/dev/null
    find "$d" -type f -exec chmod 640 {} + 2>/dev/null
  done
  [ -f "${SETTINGS_FILE}" ] && chmod 600 "${SETTINGS_FILE}"
  return 0
}

# 227.0.1.1 把应用本体解压到 TRIM_PKGVAR/server 运行；改为直接在 TRIM_APPDEST 运行后清掉这份旧拷贝。
# 只删本应用自己的目录（路径里必须带 moontvplus），防止变量异常时误删。
remove_legacy_server() {
  local d
  for d in "${VAR_DIR}/server" "${VAR_DIR}/server.new" "${VAR_DIR}/server.old"; do
    [ -e "$d" ] || continue
    case "$d" in
      */moontvplus/*) rm -rf --one-file-system "$d" && log "removed legacy ${d}" ;;
      *) log "refuse to remove unexpected path: $d" ;;
    esac
  done
  return 0
}

# 读取配置。先清空同名变量，避免沿用调用方环境里的旧值。
load_settings() {
  unset MOONTV_PORT MOONTV_USERNAME MOONTV_PASSWORD MOONTV_CRON_PASSWORD
  # shellcheck disable=SC1090
  [ -f "${SETTINGS_FILE}" ] && . "${SETTINGS_FILE}"
  if ! valid_port "${MOONTV_PORT:-}" || [ -z "${MOONTV_USERNAME:-}" ] || [ -z "${MOONTV_PASSWORD:-}" ] \
     || [ -z "${MOONTV_CRON_PASSWORD:-}" ]; then
    user_error "MoonTVPlus 配置缺失或无效（${SETTINGS_FILE}），请重新安装应用。"
    return 1
  fi
}

save_settings() {  # port username password cron_password
  local tmp="${SETTINGS_FILE}.tmp"
  mkdir -p "${ETC_DIR}" || return 1
  ( umask 077
    printf 'MOONTV_PORT=%q\nMOONTV_USERNAME=%q\nMOONTV_PASSWORD=%q\nMOONTV_CRON_PASSWORD=%q\n' \
      "$1" "$2" "$3" "$4" > "${tmp}" ) || return 1
  chmod 600 "${tmp}" && mv -f "${tmp}" "${SETTINGS_FILE}"
}

random_hex() {
  od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
}

# 应用本体是否完整、运行时要写的位置是否可写
check_server() {
  if [ ! -f "${SERVER_DIR}/start.js" ] || [ ! -x "${NODE}" ]; then
    user_error "应用文件不完整（缺少 server/start.js 或内置 Node.js），请重新安装。"
    return 1
  fi
  if [ ! -w "${SERVER_DIR}/public" ] || [ ! -w "${SERVER_DIR}/.next" ]; then
    user_error "应用目录不可写（${SERVER_DIR}），MoonTVPlus 启动时需要写入 public/manifest.json 与 .next/cache。"
    return 1
  fi
  return 0
}

is_running() {
  local pid
  [ -f "${PID_FILE}" ] || return 1
  pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

start_app() {
  local pid
  is_running && return 0
  load_settings || return 1
  if port_open "${MOONTV_PORT}"; then
    user_error "端口 ${MOONTV_PORT} 已被其他程序占用，请释放该端口后再启动 MoonTVPlus。"
    return 1
  fi
  check_server || return 1
  prepare_dirs || return 1
  remove_legacy_server

  # 日志太大时截断，只留尾部
  if [ "$(stat -c %s "${LOG_FILE}" 2>/dev/null || echo 0)" -gt 10485760 ]; then
    tail -c 2097152 "${LOG_FILE}" > "${LOG_FILE}.tmp" && mv -f "${LOG_FILE}.tmp" "${LOG_FILE}" && chmod 640 "${LOG_FILE}"
  fi

  cd "${SERVER_DIR}" || { user_error "无法进入 ${SERVER_DIR}"; return 1; }
  # setsid：自成进程组，stop 时可以整组清理。后台子进程不是组长，setsid 直接 exec，$! 就是 node 本身。
  env -i \
    PATH="${PATH}" HOME="${HOME_DIR}" LANG=C.UTF-8 TZ="${TZ:-Asia/Shanghai}" \
    NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 PORT="${MOONTV_PORT}" \
    USERNAME="${MOONTV_USERNAME}" PASSWORD="${MOONTV_PASSWORD}" \
    NEXT_PUBLIC_STORAGE_TYPE=d1 SQLITE_DB_PATH="${DATA_DIR}/moontv.db" \
    CRON_PASSWORD="${MOONTV_CRON_PASSWORD}" \
    OFFLINE_DOWNLOAD_DIR="${DATA_DIR}/offline-download" \
    setsid "${NODE}" start.js >> "${LOG_FILE}" 2>&1 < /dev/null &
  pid=$!
  echo "${pid}" > "${PID_FILE}"
  log "started pid=${pid} port=${MOONTV_PORT}"

  # 首次启动要建库、执行迁移；进程中途退出要如实报告失败，不能谎报已启动。
  for _ in $(seq 1 90); do
    if ! kill -0 "${pid}" 2>/dev/null; then
      rm -f "${PID_FILE}"
      user_error "MoonTVPlus 启动失败：$(tail -n 5 "${LOG_FILE}" 2>/dev/null | tr '\n' ' ')"
      return 1
    fi
    port_open "${MOONTV_PORT}" && return 0
    sleep 1
  done
  log "port ${MOONTV_PORT} not ready after 90s; server is still starting"
  return 0
}

stop_app() {
  local pid
  if ! is_running; then
    rm -f "${PID_FILE}"
    return 0
  fi
  pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
  kill -TERM -- "-${pid}" 2>/dev/null || kill -TERM "${pid}" 2>/dev/null
  for _ in $(seq 1 30); do
    kill -0 "${pid}" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "${pid}" 2>/dev/null; then
    log "pid ${pid} did not exit within 30s, killing process group"
    kill -KILL -- "-${pid}" 2>/dev/null || kill -KILL "${pid}" 2>/dev/null
  fi
  rm -f "${PID_FILE}"
  log "stopped pid=${pid}"
}
